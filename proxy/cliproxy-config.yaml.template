# CLIProxyAPI config template -- Phase 0 of the LiteLLM replacement.
#
# CPA does NOT interpolate environment variables in this file (unlike LiteLLM's
# `os.environ/VAR`); config_load.go is a plain yaml.Unmarshal. So this is a
# template: `scripts/render-cliproxy-config.sh` substitutes the dollar-brace
# placeholders below from .env and writes proxy/cliproxy-config.yaml, which is
# gitignored because it holds the literal keys.
#
# Phase 0 intentionally mirrors proxy/litellm-config.yaml model-for-model, so
# `PROXY_URL=http://localhost:8317 ./scripts/validate-proxy.sh` is an
# apples-to-apples comparison against the LiteLLM path on :4000.

port: 8317

# Bearer key the agent and the interactive CLI use to authenticate to the proxy.
# Same value LiteLLM took as `general_settings.master_key`, so ANTHROPIC_AUTH_TOKEN
# does not change between the two proxies during the migration.
api-keys:
  - "${PROXY_MASTER_KEY}"

# CPA writes per-credential state here (cooldown files, OAuth tokens). We use no
# OAuth providers, but the directory still has to be writable.
auth-dir: "/CLIProxyAPI/auths"

# NVIDIA NIM is not a native CPA provider the way it is in LiteLLM; it is reached
# as a generic OpenAI-compatible upstream. internal/runtime/executor/openai_compat_executor.go
# takes the request's source format (`claude` when it arrives on /v1/messages),
# translates it to OpenAI, POSTs {base-url}/chat/completions, and translates the
# response back -- streaming and tool calls included. That is exactly the role
# LiteLLM's `use_chat_completions_url_for_anthropic_messages: true` played.
openai-compatibility:
  - name: "nvidia-nim"
    base-url: "https://integrate.api.nvidia.com/v1"
    # Cooldown is a failover mechanism: it parks a bad credential so traffic
    # moves to a healthy one. With a single key there is nothing to fail over
    # to, so cooling it turns one model's error into a total outage across
    # every model sharing the credential. Observed during the Phase 0 gate: a
    # 404 on one model was immediately followed by 503 auth_unavailable on the
    # next request to a different model.
    # Phase 1 adds more keys to the pool; flip this back to false then.
    disable-cooling: true
    api-key-entries:
      # Phase 1 adds more entries here; the pool rotates per routing.strategy.
      - api-key: "${NVIDIA_NIM_API_KEY}"
    # Upstream names verified against a live GET /v1/models on 2026-09-23.
    # Three of the four models in proxy/litellm-config.yaml no longer exist:
    # z-ai/glm-5.1 hit end-of-life on 2026-07-02, and deepseek-ai/deepseek-v4-pro
    # and openai/gpt-oss-120b are gone from the catalog. Re-check with:
    #   curl -H "Authorization: Bearer $NVIDIA_NIM_API_KEY" \
    #        https://integrate.api.nvidia.com/v1/models
    # Phase 0 gate results, measured 2026-09-23 on this account:
    #   z-ai/glm-5.3        PASS, ~1s warm    <- the only model fast enough to
    #                                            drive an interactive session
    #   z-ai/glm-5.3-flash  PASS, 149-429s    <- correct tool_use, but NIM
    #                                            cold-start makes it slow
    #   moonshotai/kimi-k2.6  404 "Not found for account" -- listed in
    #                         GET /v1/models but not entitled here, so it is
    #                         NOT aliased below.
    #   kimi-k3 / deepseek-v4.1-flash / gpt-oss-20b: cold-start bound, not
    #                         confirmed. Left aliased so they can be warmed and
    #                         retested, but do not rely on them yet.
    # The latency is NVIDIA's free tier, not the proxy: glm-5.3-flash took 429s
    # on a direct curl to integrate.api.nvidia.com with CPA out of the path.
    models:
      # Aliases matched against real Claude model names, so the SDK's own
      # assumptions about model identity keep holding (same trick as the
      # LiteLLM config this replaces).
      - name: "z-ai/glm-5.3"
        alias: "claude-sonnet-4-6"
      - name: "moonshotai/kimi-k3"
        alias: "claude-opus-4-8"
      - name: "z-ai/glm-5.3-flash"
        alias: "claude-haiku-4-5"
      # Friendly direct aliases for interactive use via scripts/claude-nim.sh.
      # Repeating an upstream `name` under a second alias is supported --
      # buildOpenAICompatibilityConfigModels emits one catalog entry per list
      # item, keyed by alias.
      - name: "z-ai/glm-5.3"
        alias: "glm"
      - name: "z-ai/glm-5.3-flash"
        alias: "glm-flash"
      # `kimi` points at k3 because k2.6 returns 404 on this account.
      - name: "moonshotai/kimi-k3"
        alias: "kimi"
      - name: "deepseek-ai/deepseek-v4.1-flash"
        alias: "deepseek"
      - name: "openai/gpt-oss-20b"
        alias: "gpt-oss"
