node_modules/
dist/
*.log
.env
.DS_Store

# Rendered from proxy/cliproxy-config.yaml.template by
# scripts/render-cliproxy-config.sh. Holds literal API keys because
# CLIProxyAPI has no env-var interpolation in its config.
proxy/cliproxy-config.yaml
# CPA per-credential state (cooldown files, tokens). The directory itself is
# tracked: docker-compose bind-mounts it, and Docker creates a missing host
# path as root, which the non-root container user then cannot write to.
proxy/auths/*
!proxy/auths/.gitkeep
# Request logs hold full prompt and response bodies — treat as sensitive.
proxy/logs/*
!proxy/logs/.gitkeep

# Target repo the agent edits — mounted, not part of this repo.
workspace/*
!workspace/.gitkeep
